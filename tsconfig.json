{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["index.ts", "brand/**/*.ts", "components/**/*.ts", "components/**/*.tsx", "catalogue/**/*.tsx", "test/consumer.tsx"],
  "exclude": ["dist", "node_modules"]
}
