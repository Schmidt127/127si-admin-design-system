{
  "name": "@127si/design-system",
  "version": "1.1.0",
  "private": true,
  "description": "The 127 Sports Intensity design system: brand tokens, themes, fonts and shared React components.",
  "type": "module",
  "files": ["dist", "brand/RULES.md", "brand/kit", "components/*/RULES.md", "docs"],
  "types": "./dist/index.d.ts",
  "sideEffects": ["*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*",
    "./assets/*": "./dist/assets/*",
    "./logos/*": "./dist/logos/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"components/**/*.test.tsx\" \"test/*.test.mjs\"",
    "check:ui-en-dash": "node scripts/check-no-ui-en-dash.mjs",
    "check:dist": "node scripts/build.mjs && git diff --exit-code -- dist && node scripts/check-dist-untracked.mjs",
    "check": "npm run build && npm run typecheck && npm run check:ui-en-dash && npm test"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.10.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
